PORT=3003

# ── Supabase (same project as course-web) ────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── The web app's URL ──────────────────────────────────────────────
# Must point at your course-web deployment's URL (the same value as
# course-web's NEXT_PUBLIC_SITE_URL).
KURSO_URL=https://your-domain.example

# ── Shared secret with course-web and telegram-bot — same value everywhere ──
INTERNAL_BOT_SECRET=

# ── Signed-link secrets — must match course-web's values exactly ──
LESSON_LINK_SECRET=
WHATSAPP_LINK_SECRET=

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────
# From Meta for Developers → your App → WhatsApp → API Setup.
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
# App Secret, used to verify that inbound webhook calls really came from Meta.
META_APP_SECRET=
# A string you choose yourself, entered into Meta's webhook config too —
# Meta echoes it back on webhook verification.
META_WEBHOOK_VERIFY_TOKEN=
# A second, separate signature-verification secret used on the webhook route.
WHATSAPP_WEBHOOK_SECRET=
META_GRAPH_VERSION=v21.0
META_TEMPLATE_LANG=en

# ── Approved WhatsApp message template names ──────────────────────
# Each of these must be an APPROVED template in Meta Business Manager
# before it will actually send. The names below are just examples —
# use whatever you named yours.
META_LIVE_REMINDER_TEMPLATE_NAME=live_class_reminder
META_RECORDING_READY_TEMPLATE_NAME=recording_ready
META_RECORDING_UNAVAILABLE_TEMPLATE_NAME=recording_unavailable
META_WORKSHOP_CONFIRMATION_TEMPLATE_NAME=workshop_confirmation
META_WORKSHOP_REMINDER_TEMPLATE_NAME=workshop_reminder