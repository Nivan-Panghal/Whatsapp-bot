PORT=3003

# ── Supabase (same project as course-web) ────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── The web app's URL ──────────────────────────────────────────────
# Must point at your course-web deployment's URL (the same value as
# course-web's NEXT_PUBLIC_SITE_URL).
KURSO_URL=https://www.kurso.in

# ── Shared secret with course-web and telegram-bot — same value everywhere ──
INTERNAL_BOT_SECRET=

# ── Signed-link secrets ────────────────────────────────────────────
# IMPORTANT: these must be the exact SAME value as course-web's and
# telegram-bot's LESSON_LINK_SECRET / TELEGRAM_LINK_SECRET /
# WHATSAPP_LINK_SECRET — one shared secret across all three services.
# This repo checks WHATSAPP_LINK_SECRET first (the other two check
# LESSON_LINK_SECRET first) — if these end up set to different values
# anywhere, a link this bot signs will fail verification on the
# website. Keeping every copy identical makes that ordering
# difference harmless.
# Note: if BOTH of these are left empty, this bot silently falls back
# to signing links with WHATSAPP_WEBHOOK_SECRET instead — don't rely
# on that, set these explicitly.
LESSON_LINK_SECRET=
WHATSAPP_LINK_SECRET=

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────
# From Meta for Developers → your App → WhatsApp → API Setup.
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
# App Secret, used to verify that inbound webhook calls really came from Meta.
META_APP_SECRET=
# A random string you generate yourself (openssl rand -hex 32 works well,
# 32–64 chars, no character restrictions from Meta). Must also be entered
# into Meta's webhook config field — the two copies have to match exactly.
META_WEBHOOK_VERIFY_TOKEN=

# Despite the name, this is NOT checked against anything Meta sends —
# the real webhook verification is META_APP_SECRET (signature) and
# META_WEBHOOK_VERIFY_TOKEN (handshake) below. This variable is only
# used as a last-resort fallback value for the link-signing secret if
# both LESSON_LINK_SECRET and WHATSAPP_LINK_SECRET are empty — nothing
# needs to be registered in Meta's dashboard for this one.
WHATSAPP_WEBHOOK_SECRET=
META_GRAPH_VERSION=v25.0
META_TEMPLATE_LANG=en

# ── Approved WhatsApp message template names ──────────────────────
# Each of these must be an APPROVED template in Meta Business Manager
# before it will actually send. The names below are just examples —
# use whatever you named yours.
META_LIVE_REMINDER_TEMPLATE_NAME=live_class_reminder
META_RECORDING_READY_TEMPLATE_NAME=recording_ready
META_RECORDING_UNAVAILABLE_TEMPLATE_NAME=recording_unavailable
META_WORKSHOP_CONFIRMATION_TEMPLATE_NAME=workshop_confirmation
META_WORKSHOP_REMINDER_TEMPLATE_NAME=workshop_reminder